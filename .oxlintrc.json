{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": null,
  "categories": {},
  "rules": {
    "typescript/no-floating-promises": [
      "warn",
      {
        "ignoreIIFE": true,
        "ignoreVoid": true
      }
    ],
    "no-base-to-string": [
      "warn",
      {
        "ignoredTypeNames": ["ObjectID"]
      }
    ],
    "typescript/unbound-method": [
      "warn",
      {
        "ignoreStatic": true
      }
    ]
  },
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "settings": {},
  "env": {
    "builtin": true
  },
  "globals": {},
  "ignorePatterns": ["test/**", "machine-translation.ts", "extract-translations.ts", "**/*.spec.ts"]
}
